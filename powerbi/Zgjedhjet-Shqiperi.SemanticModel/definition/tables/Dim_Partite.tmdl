table Dim_Partite
	lineageTag: 10edf8e0-2df9-4945-9a2d-bb86ec6bb82c

	/// Hex color for the selected party/group. Use in Format > Colors > fx > Field value.
	measure 'Ngjyra Partia' = IF ( HASONEVALUE ( 'Dim_Partite'[Grupi i detajuar] ), SELECTEDVALUE ( 'Dim_Partite'[Ngjyra e detajuar] ), SELECTEDVALUE ( 'Dim_Partite'[Ngjyra], "#9E9E9E" ) )
		lineageTag: d2f37ff4-2169-4cba-9c6c-652b5e080551

	column Order
		dataType: int64
		formatString: 0
		lineageTag: 4e88e65c-45d9-4b71-9629-67d3cd43ac84
		summarizeBy: none
		sourceColumn: Order

		annotation SummarizationSetBy = Automatic

	column Partia
		dataType: string
		lineageTag: 3e187ca1-5822-497f-8c4c-24a618aa3b40
		summarizeBy: none
		sourceColumn: Partia
		sortByColumn: Order

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Grupi Order' = SWITCH ( TRUE (), 'Dim_Partite'[Partia] IN { "PS", "PSD" }, 1, 'Dim_Partite'[Partia] IN { "ADR", "AKSH", "DZH", "KEA", "LA" }, 99, 'Dim_Partite'[Order] )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a5f9191c-cce2-4957-a99f-0f0c53e4231a
		summarizeBy: none

	column Grupi = SWITCH ( TRUE (), 'Dim_Partite'[Partia] IN { "PS", "PSD" }, "PS + PSD", 'Dim_Partite'[Partia] IN { "ADR", "AKSH", "DZH", "KEA", "LA" }, "Te tjeret", 'Dim_Partite'[Partia] )
		dataType: string
		lineageTag: e71206e6-f5e3-4c0e-a56f-03b3e6a2acd8
		summarizeBy: none
		sortByColumn: 'Grupi Order'

		changedProperty = SortByColumn

	column Ngjyra =
			SWITCH ( 'Dim_Partite'[Grupi],
			    "PS + PSD", "#5E3894",
			    "PS", "#5E3894",
			    "PD-ASHM", "#00529C",
			    "NISMA-SHB", "#F48221",
			    "PSD", "#0C5D34",
			    "MUNDESIA", "#FFC04D",
			    "L. BASHKE", "#E82D36",
			    "Te tjeret", "#9E9E9E",
			    "#9E9E9E"
			)
		dataType: string
		lineageTag: 1c3483d0-1155-4288-b271-d0edb51d4ace
		summarizeBy: none

	column 'Grupi i detajuar Order' = IF ( 'Dim_Partite'[Partia] IN { "ADR", "AKSH", "DZH", "KEA", "LA" }, 99, 'Dim_Partite'[Order] )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c2f93fb1-a2c6-4907-a00f-d7cd9061fff5
		summarizeBy: none

	/// PS dhe PSD veç e veç; partitë e vogla si Te tjeret
	column 'Grupi i detajuar' = IF ( 'Dim_Partite'[Partia] IN { "ADR", "AKSH", "DZH", "KEA", "LA" }, "Te tjeret", 'Dim_Partite'[Partia] )
		dataType: string
		lineageTag: 4ef94067-8a9a-4399-99b9-8cf354cd459f
		summarizeBy: none
		sortByColumn: 'Grupi i detajuar Order'

		changedProperty = SortByColumn

	column 'Ngjyra e detajuar' = SWITCH ( 'Dim_Partite'[Grupi i detajuar], "PS", "#5E3894", "PSD", "#0C5D34", "PD-ASHM", "#00529C", "MUNDESIA", "#FFC04D", "NISMA-SHB", "#F48221", "L. BASHKE", "#E82D36", "#9E9E9E" )
		dataType: string
		isHidden
		lineageTag: e1004dfc-e473-4422-8297-5cb56e60936b
		summarizeBy: none

	column 'Subjekti skenar Order' = SWITCH ( TRUE (), 'Dim_Partite'[Partia] IN { "NISMA-SHB", "MUNDESIA", "L. BASHKE" }, 1, 'Dim_Partite'[Partia] IN { "PS", "PSD" }, 2, 'Dim_Partite'[Partia] = "PD-ASHM", 3, 4 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9a52dc3d-062c-465b-8cc1-44aacf6907df
		summarizeBy: none

	/// Skenari 2027: NISMA-SHB, MUNDESIA dhe L. BASHKE si Kualicioni SHESHIT; PS dhe PSD si një koalicion.
	column 'Subjekti skenar' = SWITCH ( TRUE (), 'Dim_Partite'[Partia] IN { "NISMA-SHB", "MUNDESIA", "L. BASHKE" }, "Kualicioni SHESHIT", 'Dim_Partite'[Partia] IN { "PS", "PSD" }, "PS + PSD", 'Dim_Partite'[Partia] IN { "ADR", "AKSH", "DZH", "KEA", "LA" }, "Te tjeret", 'Dim_Partite'[Partia] )
		dataType: string
		lineageTag: 297bfac7-ab02-49e3-828e-5ed0f1aba70b
		summarizeBy: none
		sortByColumn: 'Subjekti skenar Order'

	partition 'Sort Partite' = m
		mode: import
		source =
				let
				    Source = #"polling station",
				    #"Filtered Rows" = Table.SelectRows(Source, each [Index] = 1),
				    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"Index"}),
				    #"Removed Other Columns" = Table.SelectColumns(#"Removed Columns",{"v2", "v3"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns"),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Duplicates",{{"v2", "Order"}, {"v3", "Partia"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"Order", Int64.Type}, {"Partia", type text}}),
				    Prioriteti = {"PS", "PD-ASHM", "PSD", "MUNDESIA", "NISMA-SHB", "L. BASHKE"},
				    #"Added Rank" = Table.AddColumn(#"Changed Type", "Rank", each let p = List.PositionOf(Prioriteti, [Partia]) in if p = -1 then 100 + [Order] else p, Int64.Type),
				    #"Sorted Rows" = Table.Sort(#"Added Rank", {{"Rank", Order.Ascending}}),
				    #"Added Index" = Table.AddIndexColumn(#"Sorted Rows", "New Order", 1, 1, Int64.Type),
				    #"Removed Old Order" = Table.RemoveColumns(#"Added Index", {"Order", "Rank"}),
				    #"Renamed Order" = Table.RenameColumns(#"Removed Old Order", {{"New Order", "Order"}})
				in
				    #"Renamed Order"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

