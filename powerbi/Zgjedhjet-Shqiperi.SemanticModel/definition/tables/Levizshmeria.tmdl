	partition Levizshmeria = m
		mode: import
		source =
				let
				    Promoted = Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & "krahasime\levizshmeria_vota_2021_2023_2025.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Viti", Int64.Type}, {"Qarku", type text}, {"Bashkia", type text}, {"Njesia administrative", type text}, {"Grupi", type text}, {"Vota", Int64.Type}}, "en-US"),
				    Emri = Table.ReplaceValue(Typed, "Njësia Administrative", "Nj.Ad.", Replacer.ReplaceText, {"Njesia administrative"})
				in
				    Emri

	annotation PBI_ResultType = Table

