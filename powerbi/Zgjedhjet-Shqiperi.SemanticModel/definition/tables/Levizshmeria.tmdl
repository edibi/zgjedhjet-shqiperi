/// Votat sipas grupit të partive dhe njësisë administrative, gjithë Shqipëria: Kuvendi 2021, Këshilli bashkiak 2023, Kuvendi 2025 (brenda vendit).
/// Burimi: data/krahasime/levizshmeria_vota_2021_2023_2025.csv (build_levizshmeria.py). Grupet: PS, PSD, PD (2021: PD-AN + LSI; 2023: BF + PD), NISMA-SHB (NTH), MUNDESIA, BASHKE, Te tjeret.
table Levizshmeria
	lineageTag: aeb37a6b-143a-4dc9-a39f-d865e28e16df

	/// Indeksi i Pedersenit 2021→2025: 0,5 × Σ|ndryshimi i përqindjes| së grupeve, në pikë përqindjeje (0–100). Ndjek çdo nivel gjeografik (Qarku, Bashkia, Nj.Ad.).
	measure 'Pedersen 2021-2025' = VAR njesite = CALCULATETABLE(SUMMARIZE('Qenderat e votimit', 'Qenderat e votimit'[Bashkia], 'Qenderat e votimit'[NjA]), REMOVEFILTERS(Dim_Viti)) VAR g = CALCULATETABLE(ADDCOLUMNS(VALUES('Levizshmeria'[Grupi]), "@a", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2021), "@b", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2025)), TREATAS(njesite, 'Levizshmeria'[Bashkia], 'Levizshmeria'[NjA]), REMOVEFILTERS('Levizshmeria'[Viti])) VAR ta = SUMX(g, [@a]) VAR tb = SUMX(g, [@b]) RETURN IF(ta > 0 && tb > 0, 50 * SUMX(g, ABS(DIVIDE([@b], tb) - DIVIDE([@a], ta))))
		formatString: 0.0
		displayFolder: Lëvizshmëria
		lineageTag: 0e1a34f9-1a84-4385-80e8-caef7f379c31

	/// Pjesa e indeksit 2021→2025 që vjen nga grupet pa asnjë votë në atë zonë në 2021 (subjektet e reja aty).
	measure 'Pedersen 2021-2025 nga subjektet e reja' = VAR njesite = CALCULATETABLE(SUMMARIZE('Qenderat e votimit', 'Qenderat e votimit'[Bashkia], 'Qenderat e votimit'[NjA]), REMOVEFILTERS(Dim_Viti)) VAR g = CALCULATETABLE(ADDCOLUMNS(VALUES('Levizshmeria'[Grupi]), "@a", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2021), "@b", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2025)), TREATAS(njesite, 'Levizshmeria'[Bashkia], 'Levizshmeria'[NjA]), REMOVEFILTERS('Levizshmeria'[Viti])) VAR ta = SUMX(g, [@a]) VAR tb = SUMX(g, [@b]) RETURN IF(ta > 0 && tb > 0, 50 * SUMX(FILTER(g, [@a] = 0), DIVIDE([@b], tb)))
		formatString: 0.0
		displayFolder: Lëvizshmëria
		lineageTag: b0faf0bc-c1b4-47e3-a836-e3fa5f16579d

	/// Indeksi i Pedersenit 2023→2025: 0,5 × Σ|ndryshimi i përqindjes| së grupeve, në pikë përqindjeje (0–100). Ndjek çdo nivel gjeografik (Qarku, Bashkia, Nj.Ad.).
	measure 'Pedersen 2023-2025' = VAR njesite = CALCULATETABLE(SUMMARIZE('Qenderat e votimit', 'Qenderat e votimit'[Bashkia], 'Qenderat e votimit'[NjA]), REMOVEFILTERS(Dim_Viti)) VAR g = CALCULATETABLE(ADDCOLUMNS(VALUES('Levizshmeria'[Grupi]), "@a", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2023), "@b", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2025)), TREATAS(njesite, 'Levizshmeria'[Bashkia], 'Levizshmeria'[NjA]), REMOVEFILTERS('Levizshmeria'[Viti])) VAR ta = SUMX(g, [@a]) VAR tb = SUMX(g, [@b]) RETURN IF(ta > 0 && tb > 0, 50 * SUMX(g, ABS(DIVIDE([@b], tb) - DIVIDE([@a], ta))))
		formatString: 0.0
		displayFolder: Lëvizshmëria
		lineageTag: c2f45b45-ddd1-48d7-a27e-3dd9e564f4f2

	/// Pjesa e indeksit 2023→2025 që vjen nga grupet pa asnjë votë në atë zonë në 2023 (subjektet e reja aty).
	measure 'Pedersen 2023-2025 nga subjektet e reja' = VAR njesite = CALCULATETABLE(SUMMARIZE('Qenderat e votimit', 'Qenderat e votimit'[Bashkia], 'Qenderat e votimit'[NjA]), REMOVEFILTERS(Dim_Viti)) VAR g = CALCULATETABLE(ADDCOLUMNS(VALUES('Levizshmeria'[Grupi]), "@a", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2023), "@b", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2025)), TREATAS(njesite, 'Levizshmeria'[Bashkia], 'Levizshmeria'[NjA]), REMOVEFILTERS('Levizshmeria'[Viti])) VAR ta = SUMX(g, [@a]) VAR tb = SUMX(g, [@b]) RETURN IF(ta > 0 && tb > 0, 50 * SUMX(FILTER(g, [@a] = 0), DIVIDE([@b], tb)))
		formatString: 0.0
		displayFolder: Lëvizshmëria
		lineageTag: b5c72704-c6fc-490e-bc01-9743906495c9

	/// Indeksi i Pedersenit 2021→2023: 0,5 × Σ|ndryshimi i përqindjes| së grupeve, në pikë përqindjeje (0–100). Ndjek çdo nivel gjeografik (Qarku, Bashkia, Nj.Ad.).
	measure 'Pedersen 2021-2023' = VAR njesite = CALCULATETABLE(SUMMARIZE('Qenderat e votimit', 'Qenderat e votimit'[Bashkia], 'Qenderat e votimit'[NjA]), REMOVEFILTERS(Dim_Viti)) VAR g = CALCULATETABLE(ADDCOLUMNS(VALUES('Levizshmeria'[Grupi]), "@a", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2021), "@b", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2023)), TREATAS(njesite, 'Levizshmeria'[Bashkia], 'Levizshmeria'[NjA]), REMOVEFILTERS('Levizshmeria'[Viti])) VAR ta = SUMX(g, [@a]) VAR tb = SUMX(g, [@b]) RETURN IF(ta > 0 && tb > 0, 50 * SUMX(g, ABS(DIVIDE([@b], tb) - DIVIDE([@a], ta))))
		formatString: 0.0
		displayFolder: Lëvizshmëria
		lineageTag: b0bff5e7-0c5a-443e-8483-e686097b087a

	/// Pjesa e indeksit 2021→2023 që vjen nga grupet pa asnjë votë në atë zonë në 2021 (subjektet e reja aty).
	measure 'Pedersen 2021-2023 nga subjektet e reja' = VAR njesite = CALCULATETABLE(SUMMARIZE('Qenderat e votimit', 'Qenderat e votimit'[Bashkia], 'Qenderat e votimit'[NjA]), REMOVEFILTERS(Dim_Viti)) VAR g = CALCULATETABLE(ADDCOLUMNS(VALUES('Levizshmeria'[Grupi]), "@a", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2021), "@b", CALCULATE(SUM('Levizshmeria'[Vota]), 'Levizshmeria'[Viti] = 2023)), TREATAS(njesite, 'Levizshmeria'[Bashkia], 'Levizshmeria'[NjA]), REMOVEFILTERS('Levizshmeria'[Viti])) VAR ta = SUMX(g, [@a]) VAR tb = SUMX(g, [@b]) RETURN IF(ta > 0 && tb > 0, 50 * SUMX(FILTER(g, [@a] = 0), DIVIDE([@b], tb)))
		formatString: 0.0
		displayFolder: Lëvizshmëria
		lineageTag: fc7a2b5c-d667-472e-993d-9acf4f64ca6c

	/// Pjesa e indeksit 2021→2025 nga vota që lëvizën mes partive që ishin aty edhe në 2021 (totali − subjektet e reja).
	measure 'Pedersen 2021-2025 nga kalimi' = [Pedersen 2021-2025] - [Pedersen 2021-2025 nga subjektet e reja]
		formatString: 0.0
		displayFolder: Lëvizshmëria
		lineageTag: 88891234-040c-43a4-b6b5-f1963e32c28f

	/// Përqindja e grupit të partive në vitin e zgjedhur, për zonën e zgjedhur në slicer-in e gjeografisë.
	measure '% e grupit (lëvizshmëria)' = VAR njesite = CALCULATETABLE(SUMMARIZE('Qenderat e votimit', 'Qenderat e votimit'[Bashkia], 'Qenderat e votimit'[NjA]), REMOVEFILTERS(Dim_Viti)) VAR v = CALCULATE(SUM('Levizshmeria'[Vota]), TREATAS(njesite, 'Levizshmeria'[Bashkia], 'Levizshmeria'[NjA])) VAR tot = CALCULATE(SUM('Levizshmeria'[Vota]), TREATAS(njesite, 'Levizshmeria'[Bashkia], 'Levizshmeria'[NjA]), REMOVEFILTERS('Levizshmeria'[Grupi])) RETURN DIVIDE(v, tot)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Lëvizshmëria
		lineageTag: 32578199-53ef-4eb1-9522-83ccd91cb50e

	column Viti
		dataType: int64
