	partition Dim_Qarku = m
		mode: import
		source =
				let
				    Source = Json.Document(File.Contents(DataFolder & "kuvend-2025\raw\regional_party_results.json")),
				    Rows = Table.FromRecords(Source[data_main]{0}[data]),
				    Selected = Table.SelectColumns(Rows, {"v1", "v6", "v8", "v10", "v10_1"}),
				    Decoded = Table.TransformColumns(Selected, {{"v1", each Text.Upper(Text.Replace(Text.Replace(Text.Replace(Text.Replace(_, "&Euml;", "Ë"), "&euml;", "ë"), "&Ccedil;", "Ç"), "&ccedil;", "ç")), type text}}),
				    Typed = Table.TransformColumnTypes(Decoded, {{"v6", Int64.Type}, {"v8", Int64.Type}, {"v10", Int64.Type}, {"v10_1", Int64.Type}}),
				    Renamed = Table.RenameColumns(Typed, {{"v1", "Qarku"}, {"v6", "Zgjedhes ne liste"}, {"v8", "Votues"}, {"v10", "Vota te vlefshme brenda"}, {"v10_1", "Vota te vlefshme diaspora"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

