	partition 'Rezultatet Qarqe' = m
		mode: import
		source =
				let
				    Source = Json.Document(File.Contents(DataFolder & "kuvend-2025\raw\regional_party_results.json")),
				    Rows = Table.FromRecords(Source[data_main]{1}[data]),
				    Selected = Table.SelectColumns(Rows, {"v1", "v3", "v5", "v5_1", "v5_2", "v6"}),
				    Decoded = Table.TransformColumns(Selected, {{"v1", each Text.Upper(Text.Replace(Text.Replace(Text.Replace(Text.Replace(_, "&Euml;", "Ë"), "&euml;", "ë"), "&Ccedil;", "Ç"), "&ccedil;", "ç")), type text}}),
				    Seats = Table.TransformColumns(Decoded, {{"v6", each if _ = null or _ = "" then 0 else Number.From(_), Int64.Type}}),
				    Typed = Table.TransformColumnTypes(Seats, {{"v3", type text}, {"v5", Int64.Type}, {"v5_1", Int64.Type}, {"v5_2", Int64.Type}}),
				    Renamed = Table.RenameColumns(Typed, {{"v1", "Qarku"}, {"v3", "Partia"}, {"v5", "Vota brenda"}, {"v5_1", "Vota nga diaspora"}, {"v5_2", "Vota gjithsej"}, {"v6", "Nr mandatesh"}}),
				    EmriPartise = Table.ReplaceValue(Renamed, "BASHKE", "L. BASHKE", Replacer.ReplaceValue, {"Partia"}),
				    EmriPD = Table.ReplaceValue(EmriPartise, "PD-ASHM", "PD", Replacer.ReplaceValue, {"Partia"})
				in
				    EmriPD

	annotation PBI_ResultType = Table

