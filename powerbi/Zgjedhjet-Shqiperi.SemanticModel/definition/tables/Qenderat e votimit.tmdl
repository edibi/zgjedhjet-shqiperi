	hierarchy Gjeografia
		lineageTag: 05ea68df-f70b-4627-a6bf-8960eddc0281

		level Qarku
			lineageTag: 6c3e8664-791d-4305-b0fc-a70b836b2efc
			column: Qarku

		level Bashkia
			lineageTag: 08a5e9f5-5c4e-4cab-b24e-2e863e5b5b01
			column: Bashkia

		level NjA
			lineageTag: 08983710-a607-47cb-8e7b-b0106442e008
			column: NjA

		level 'Qender Votimi'
			lineageTag: dda33c8c-33f9-4387-87ab-a07c5f0a583f
			column: 'Qender Votimi'

	partition 'Qenderat e votimit' = m
		mode: import
		source =
				let
				    Source = #"polling station",
				    #"Filtered Rows" = Table.SelectRows(Source, each [Index] = 0),
				    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"Index"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Columns",{{"v1", type text}, {"v2", type text}, {"v3", type text}, {"v5", type text}, {"v6", Int64.Type}, {"v7", Int64.Type}, {"v8", Int64.Type}, {"v9", Int64.Type}, {"v10", Int64.Type}, {"v11", Int64.Type}, {"v12", Int64.Type}}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Changed Type","&euml;","ë",Replacer.ReplaceText,{"v2", "v3"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Replaced Value2","&ccedil;","ç",Replacer.ReplaceText,{"v2", "v3"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","&Euml;","Ë",Replacer.ReplaceText,{"v1"}),
				    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value1","&Ccedil;","Ç",Replacer.ReplaceText,{"v1"}),
				    #"Capitalized Each Word" = Table.TransformColumns(#"Replaced Value3",{{"v2", Text.Proper, type text}, {"v3", Text.Proper, type text}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Capitalized Each Word",{{"v1", "Qarku"}, {"v10", "Vota te vlefshme"}, {"v6", "Nr total i zgjedhesve ne list"}, {"v7", "Nr total i zgjedhesve gra ne list"}, {"v11", "Vota te pavlefshme"}, {"v12", "Nr i qendrave te votimit te numeruara"}, {"v8", "Nr i votuesve ne qendrat e votimit te numeruara"}, {"v9", "Nr i votueseve gra ne qendrat e votimit te numeruara"}, {"v2", "Bashkia"}, {"v3", "Njesia administrative"}, {"v5", "Qender Votimi"}}),
				    Reg = Json.Document(File.Contents(DataFolder & "kuvend-2025\raw\regional_party_results.json")),
				    DiaRows = Reg[data_main]{0}[data],
				    Diaspora = Table.FromRecords(List.Transform(DiaRows, each
				        let q = Text.Upper(Text.Replace(Text.Replace(Text.Replace(Text.Replace([v1], "&Euml;", "Ë"), "&euml;", "ë"), "&Ccedil;", "Ç"), "&ccedil;", "ç"))
				        in [Qarku = q, Bashkia = "Diaspora", #"Njesia administrative" = "Diaspora", #"Qender Votimi" = "DIA-" & q,
				            #"Nr total i zgjedhesve ne list" = Number.From([v40]), #"Nr total i zgjedhesve gra ne list" = Number.From([v41]),
				            #"Nr i votuesve ne qendrat e votimit te numeruara" = Number.From([v42]),
				            #"Nr i votueseve gra ne qendrat e votimit te numeruara" = Number.From([v43]),
				            #"Vota te vlefshme" = Number.From([v10_1]), #"Vota te pavlefshme" = Number.From([v11_1]),
				            #"Nr i qendrave te votimit te numeruara" = 0])),
				    Combined = Table.Combine({#"Renamed Columns", Diaspora}),
				    Typed = Table.TransformColumnTypes(Combined, {{"Qarku", type text}, {"Bashkia", type text}, {"Njesia administrative", type text}, {"Qender Votimi", type text}, {"Nr total i zgjedhesve ne list", Int64.Type}, {"Nr total i zgjedhesve gra ne list", Int64.Type}, {"Nr i votuesve ne qendrat e votimit te numeruara", Int64.Type}, {"Nr i votueseve gra ne qendrat e votimit te numeruara", Int64.Type}, {"Vota te vlefshme", Int64.Type}, {"Vota te pavlefshme", Int64.Type}, {"Nr i qendrave te votimit te numeruara", Int64.Type}}),
				    PopSel = Table.SelectColumns(Table.FromRecords(Json.Document(File.Contents(DataFolder & "popullsia\popullsia_2025_qarqe.json"))[data]), {"Qarku", "Shtetas_18plus", "Shtetas_femra_18plus"}),
				    ListQ = Table.Group(Table.SelectRows(Typed, each [Bashkia] <> "Diaspora"), {"Qarku"}, {{"ListaQ", each List.Sum([Nr total i zgjedhesve ne list]), type number}, {"ListaGraQ", each List.Sum([Nr total i zgjedhesve gra ne list]), type number}}),
				    J1 = Table.ExpandTableColumn(Table.NestedJoin(Typed, {"Qarku"}, ListQ, {"Qarku"}, "LQ", JoinKind.LeftOuter), "LQ", {"ListaQ", "ListaGraQ"}),
				    J2 = Table.ExpandTableColumn(Table.NestedJoin(J1, {"Qarku"}, PopSel, {"Qarku"}, "P", JoinKind.LeftOuter), "P", {"Shtetas_18plus", "Shtetas_femra_18plus"}),
				    Res = Table.AddColumn(J2, "Zgjedhes rezidente (vleresim)", each if [Bashkia] = "Diaspora" then 0 else [Nr total i zgjedhesve ne list] * [Shtetas_18plus] / [ListaQ], type number),
				    ResW = Table.AddColumn(Res, "Zgjedhese gra rezidente (vleresim)", each if [Bashkia] = "Diaspora" then 0 else [Nr total i zgjedhesve gra ne list] * [Shtetas_femra_18plus] / [ListaGraQ], type number),
				    Vendi = Table.AddColumn(ResW, "Vendi i votimit", each if [Bashkia] = "Diaspora" then "Diaspora" else "Në Shqipëri", type text),
				    Final = Table.RemoveColumns(Vendi, {"ListaQ", "ListaGraQ", "Shtetas_18plus", "Shtetas_femra_18plus"}),
				    NjaEmri = Table.ReplaceValue(Final, "Njësia Administrative", "NjA", Replacer.ReplaceText, {"Njesia administrative"})
				in
				    NjaEmri

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

