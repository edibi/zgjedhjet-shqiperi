	column 'Grupi i grave' = VAR v = 'Qenderat e votimit'[Nr i votuesve ne qendrat e votimit te numeruara] VAR w = 'Qenderat e votimit'[Nr i votueseve gra ne qendrat e votimit te numeruara] VAR s = DIVIDE(w, v) RETURN IF(v > 0 && w > 0 && 'Qenderat e votimit'[Bashkia] <> "Diaspora", SWITCH(TRUE(), s < 0.45, "1. nën 45%", s < 0.48, "2. 45–48%", s < 0.51, "3. 48–51%", s < 0.54, "4. 51–54%", "5. mbi 54%"), "Pa të dhëna")
		dataType: string
		lineageTag: 1b91363b-5593-4ad5-a05a-b38281405ad2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

