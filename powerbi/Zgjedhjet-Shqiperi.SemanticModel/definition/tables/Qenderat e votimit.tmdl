table 'Qenderat e votimit'
	lineageTag: 0ceed427-4d14-4268-8b0b-8f426a8bf1f4

	/// Votues = vota te vlefshme + te pavlefshme (e plote per cdo QV, perfshire diasporen)
	measure 'Votues gjithsej' = SUM('Qenderat e votimit'[Vota te vlefshme]) + SUM('Qenderat e votimit'[Vota te pavlefshme])
		formatString: #,0
		lineageTag: ff14c601-ecd9-42c0-8849-ca2482023067

	/// Lista e KQZ = të gjithë në listë, përfshirë të gjithë emigrantët (edhe diasporën e regjistruar).
	measure 'Zgjedhes (lista KQZ)' = SUM('Qenderat e votimit'[Nr total i zgjedhesve ne list])
		formatString: #,0
		lineageTag: 31fdb46c-ced1-484d-af45-5781b60efe82

	/// Rezidentë = shtetas 18+ që jetojnë në Shqipëri (INSTAT 2025), shpërndarë në QV sipas listës. Pa diasporën.
	measure 'Zgjedhes rezidente' = SUM('Qenderat e votimit'[Zgjedhes rezidente (vleresim)])
		formatString: #,0
		lineageTag: 9ef37d55-5ee3-49d1-9107-fa02242c695e

	/// Zgjedhesit sipas bazes se zgjedhur ne slicer
	measure 'Zgjedhes (baza)' = IF(SELECTEDVALUE('Baza e zgjedhesve'[Baza], "Rezidentë (INSTAT)") = "Lista e KQZ", [Zgjedhes (lista KQZ)], [Zgjedhes rezidente])
		formatString: #,0
		lineageTag: e4efa341-2174-4f74-8911-e66ba77eecfe

	/// Votues / zgjedhës sipas bazës së zgjedhur
	measure Pjesemarrja = DIVIDE([Votues (baza)], [Zgjedhes (baza)])
		formatString: 0.0%
		lineageTag: 9afa3186-3f8b-4f82-abbd-bf563d840e07

	measure 'Gra votuese' = SUMX(FILTER('Qenderat e votimit', 'Qenderat e votimit'[Nr i votuesve ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Nr i votueseve gra ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Bashkia] <> "Diaspora"), 'Qenderat e votimit'[Nr i votueseve gra ne qendrat e votimit te numeruara])
		formatString: #,0
		lineageTag: 0eea8fa8-2325-421d-a72a-363369449777

	measure 'Votues (QV me te dhena)' = SUMX(FILTER('Qenderat e votimit', 'Qenderat e votimit'[Nr i votuesve ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Nr i votueseve gra ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Bashkia] <> "Diaspora"), 'Qenderat e votimit'[Nr i votuesve ne qendrat e votimit te numeruara])
		formatString: #,0
		lineageTag: a5f1b27b-580c-4bf5-a7dd-ebd01654787e

	measure 'Zgjedhes (QV me te dhena)' = VAR b = SELECTEDVALUE('Baza e zgjedhesve'[Baza], "Rezidentë (INSTAT)") RETURN SUMX(FILTER('Qenderat e votimit', 'Qenderat e votimit'[Nr i votuesve ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Nr i votueseve gra ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Bashkia] <> "Diaspora"), IF(b = "Lista e KQZ", 'Qenderat e votimit'[Nr total i zgjedhesve ne list], 'Qenderat e votimit'[Zgjedhes rezidente (vleresim)]))
		formatString: #,0
		lineageTag: cf35cfab-1222-4760-ab89-a92e33ddc060

	measure 'Zgjedhese gra (QV me te dhena)' = VAR b = SELECTEDVALUE('Baza e zgjedhesve'[Baza], "Rezidentë (INSTAT)") RETURN SUMX(FILTER('Qenderat e votimit', 'Qenderat e votimit'[Nr i votuesve ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Nr i votueseve gra ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Bashkia] <> "Diaspora"), IF(b = "Lista e KQZ", 'Qenderat e votimit'[Nr total i zgjedhesve gra ne list], 'Qenderat e votimit'[Zgjedhese gra rezidente (vleresim)]))
		formatString: #,0
		lineageTag: eb2594e9-9ba4-4412-954b-e874dc10c6f7

	measure 'Pjesemarrja e grave' = DIVIDE([Gra votuese], [Zgjedhese gra (QV me te dhena)])
		formatString: 0.0%
		lineageTag: 625a9ac9-2c6c-4656-ac29-b0aed7fabea6

	measure 'Pjesemarrja e burrave' = DIVIDE([Votues (QV me te dhena)] - [Gra votuese], [Zgjedhes (QV me te dhena)] - [Zgjedhese gra (QV me te dhena)])
		formatString: 0.0%
		lineageTag: e3f95d92-fb64-4024-8cf4-778739bdad23

	measure 'Hendeku gjinor (pp)' = ([Pjesemarrja e burrave] - [Pjesemarrja e grave]) * 100
		formatString: 0.0
		lineageTag: c4a73682-1761-4ecd-a6df-bc1014686ae6

	measure 'Gra % e votuesve' = DIVIDE([Gra votuese], [Votues (QV me te dhena)])
		formatString: 0.0%
		lineageTag: 1c49816a-99a9-483e-a082-c5156ae9eecf

	measure 'Gra % e zgjedhesve' = CALCULATE(DIVIDE(SUM('Qenderat e votimit'[Nr total i zgjedhesve gra ne list]), SUM('Qenderat e votimit'[Nr total i zgjedhesve ne list])), 'Qenderat e votimit'[Bashkia] <> "Diaspora")
		formatString: 0.0%
		lineageTag: aed4a5ad-0404-450a-a132-e49983193566

	measure 'Mbulimi i te dhenave gjinore' = DIVIDE(SUMX(FILTER('Qenderat e votimit', 'Qenderat e votimit'[Nr i votuesve ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Nr i votueseve gra ne qendrat e votimit te numeruara] > 0 && 'Qenderat e votimit'[Bashkia] <> "Diaspora"), 'Qenderat e votimit'[Nr total i zgjedhesve ne list]), CALCULATE(SUM('Qenderat e votimit'[Nr total i zgjedhesve ne list]), 'Qenderat e votimit'[Bashkia] <> "Diaspora"))
		formatString: 0.0%
		lineageTag: 308524ae-6775-4313-83eb-b7b1635ca9eb

	/// Rezidentë: vetëm votuesit në Shqipëri. Lista e KQZ: të gjithë votuesit, përfshirë diasporën.
	measure 'Votues (baza)' =
			VAR b = SELECTEDVALUE('Baza e zgjedhesve'[Baza], "Rezidentë (INSTAT)")
			RETURN IF(b = "Lista e KQZ", [Votues gjithsej], CALCULATE([Votues gjithsej], KEEPFILTERS('Qenderat e votimit'[Vendi i votimit] = "Në Shqipëri")))
		formatString: #,0
		lineageTag: 9d7c6ea8-f87f-4c7e-8be1-54df82ef0202

